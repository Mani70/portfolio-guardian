# portfolio-guardian schedule (installed by deploy/oci/setup.sh; edit here, then re-run setup or `crontab deploy/oci/crontab` after replacing __APP__)
# Times are IST, Monday-Friday unless noted. Exchange holidays are detected by the jobs themselves (no market data -> they exit).
SHELL=/bin/bash
MAILTO=""
CRON_TZ=Asia/Kolkata
PG=__APP__/deploy/oci/job.sh

# m  h  dom mon dow  job
5    9  *   *   1-5  $PG health        # heartbeat: token, clock, disk, last runs -> Telegram
10   9  *   *   1-5  $PG intraday      # scans every 5 min until ~15:20, squares off by 15:15
12   9  *   *   1-5  $PG watch         # every 5 min: sharp falls / exit levels in all holdings -> Telegram
30   9  *   *   1-5  $PG swing-check   # record swing fills, re-price/cancel unfilled
10  16  *   *   1-5  $PG swing-plan    # rebalance decisions -> after-market orders for the next open
30  16  *   *   1-5  $PG backup        # journal + configs -> backups/ (and Object Storage if set)
40   8  1   *   *    $PG report        # monthly P&L vs Nifty ETF, charges, tax estimate -> Telegram
35   8  *   *   1    $PG universe      # Mondays: refresh the Nifty 50 list from NSE (Telegram if it changed)
37   8  *   *   1    $PG holidays      # Mondays: NSE trading holidays (month-end = real last session)
30  19  *   *   1-5  $PG insights      # swing ideas with reasons -> Telegram (information only, never traded)
30  21  *   *   1-5  $PG insights      # again if NSE's files were late (sends once a day)
15  20  *   *   1-5  $PG fo-paper      # F&O practice run on paper (Addenda 20/20a; never an order)
45  22  *   *   1-5  $PG fo-paper      # again if NSE's F&O file was late (reports once a day)
40  7   *   *   *    $PG reel          # daily education Reel -> Telegram for you to review and post on Instagram
15  17  *   *   1-5  $PG autodeploy    # GitHub main -> server, only if all tests pass (Telegram either way)
5    6  *   1   6    $PG retest        # Saturdays in January: the autopilot's yearly re-test (runs once a year)
# The 15:50 portfolio-rule check (guardian, config.yaml) is off since the holdings went to the bot; the
# price watch still alerts on sharp falls in every holding. To turn it back on, add:
# 50  15  *   *   1-5  $PG guardian
@reboot sleep 90 && $PG reboot         # tells you if OCI restarted the server
