# Copy to .env (never commit .env). On macOS/Linux: chmod 600 .env

# Option A: paste a token from indstocks.com/app/api-trading/access-tokens (expires every 24h)
INDSTOCKS_ACCESS_TOKEN=

# Option B: automatic daily login (set up TOTP on the same page first)
# Storing your MPIN and TOTP secret on disk is a real risk: anyone with this file can log in.
# Keep it on an encrypted disk, readable only by you.
INDSTOCKS_CLIENT_ID=
INDSTOCKS_MPIN=
INDSTOCKS_TOTP_SECRET=

# Telegram alerts: create a bot with @BotFather, then get your chat id from @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional (OCI server): write-only pre-authenticated request URL of an Object Storage bucket, ending in /o/.
# deploy/oci/backup.py uploads the daily backup there. Leave empty for local backups only.
OCI_BACKUP_PAR_URL=
